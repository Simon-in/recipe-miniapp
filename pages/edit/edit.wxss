.form-section {
  margin-bottom: 24rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2A26;
  margin-bottom: 24rpx;
}

.form-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.add-link {
  font-size: 26rpx;
  color: #E85D04;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-row {
  display: flex;
  gap: 32rpx;
}

.form-item.half {
  flex: 1;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #6B6560;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.form-label.required::before {
  content: '* ';
  color: #E85D04;
}

.form-input {
  background: #FFF8F0;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  line-height: 1.5;
  min-height: 80rpx;
}

.form-picker {
  background: #FFF8F0;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  color: #2D2A26;
  line-height: 1.5;
  min-height: 80rpx;
}

.input-with-unit {
  display: flex;
  align-items: center;
  background: #FFF8F0;
  border-radius: 16rpx;
  padding-right: 24rpx;
}

.input-with-unit .form-input {
  background: transparent;
  flex: 1;
}

.unit {
  font-size: 26rpx;
  color: #9E9A94;
  flex-shrink: 0;
}

.dynamic-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.dynamic-input {
  background: #FFF8F0;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.name-input {
  flex: 2;
}

.amount-input {
  flex: 1;
}

.remove-btn {
  color: #9E9A94;
  font-size: 28rpx;
  padding: 8rpx 12rpx;
  flex-shrink: 0;
}

.step-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.step-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FFF0E6;
  color: #E85D04;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 12rpx;
}

.step-textarea {
  flex: 1;
  background: #FFF8F0;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  min-height: 80rpx;
  line-height: 1.6;
}

.note-textarea {
  background: #FFF8F0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.submit-btn {
  width: 100%;
  margin: 16rpx 0 48rpx;
}

.image-upload {
  width: 100%;
}

.image-preview-wrap {
  position: relative;
}

.image-preview {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  display: block;
}

.image-actions {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 20rpx;
}

.image-action {
  font-size: 28rpx;
  color: #E85D04;
}

.image-action.remove {
  color: #D32F2F;
}

.image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 360rpx;
  background: #FFF8F0;
  border: 2rpx dashed #E8D5C4;
  border-radius: 20rpx;
}

.placeholder-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.placeholder-text {
  font-size: 28rpx;
  color: #6B6560;
  margin-bottom: 8rpx;
}

.placeholder-hint {
  font-size: 24rpx;
  color: #9E9A94;
}
