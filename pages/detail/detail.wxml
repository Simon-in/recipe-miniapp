<view class="container" wx:if="{{recipe}}">
  <!-- 封面图 -->
  <image
    wx:if="{{recipe.coverImage}}"
    class="cover-image"
    src="{{recipe.coverImage}}"
    mode="aspectFill"
    bindtap="onPreviewImage"
  />

  <!-- 标题区 -->
  <view class="hero card {{recipe.coverImage ? 'hero-with-image' : ''}}">
    <text class="hero-name">{{recipe.name}}</text>
    <view class="hero-meta">
      <view class="meta-item">
        <text class="meta-value">{{recipe.cookTime}}</text>
        <text class="meta-label">分钟</text>
      </view>
      <view class="meta-divider"></view>
      <view class="meta-item">
        <text class="meta-value">{{recipe.servings}}</text>
        <text class="meta-label">人份</text>
      </view>
      <view class="meta-divider"></view>
      <view class="meta-item">
        <text class="meta-value">{{recipe.difficulty}}</text>
        <text class="meta-label">难度</text>
      </view>
    </view>
    <view class="hero-tags">
      <text class="tag tag-orange">{{recipe.category}}</text>
    </view>
    <text class="update-time">更新于 {{recipe.updatedAtText}}</text>
  </view>

  <!-- 食材 -->
  <view class="section card">
    <view class="section-title">
      <text class="section-icon">🥬</text>
      <text>食材清单</text>
    </view>
    <view class="ingredient-list">
      <view wx:for="{{recipe.ingredients}}" wx:key="name" class="ingredient-item">
        <text class="ingredient-name">{{item.name}}</text>
        <text class="ingredient-amount">{{item.amount}}</text>
      </view>
    </view>
  </view>

  <!-- 步骤 -->
  <view class="section card">
    <view class="section-title">
      <text class="section-icon">👨‍🍳</text>
      <text>烹饪步骤</text>
    </view>
    <view class="step-list">
      <view wx:for="{{recipe.steps}}" wx:key="*this" class="step-item">
        <view class="step-number">{{index + 1}}</view>
        <text class="step-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view wx:if="{{recipe.note}}" class="section card">
    <view class="section-title">
      <text class="section-icon">💡</text>
      <text>小贴士</text>
    </view>
    <text class="note-text">{{recipe.note}}</text>
  </view>

  <!-- 底部操作 -->
  <view class="action-bar">
    <button class="btn-secondary action-btn" bindtap="onEditTap">编辑</button>
    <button class="btn-delete action-btn" bindtap="onDeleteTap">删除</button>
  </view>
</view>
