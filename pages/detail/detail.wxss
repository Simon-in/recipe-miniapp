.cover-image {
  width: 100%;
  height: 420rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  display: block;
}

.hero {
  text-align: center;
  padding: 40rpx 32rpx;
}

.hero-with-image {
  margin-top: -8rpx;
}

.hero-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #2D2A26;
  display: block;
  margin-bottom: 28rpx;
}

.hero-meta {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx;
}

.meta-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #E85D04;
}

.meta-label {
  font-size: 22rpx;
  color: #9E9A94;
  margin-top: 4rpx;
}

.meta-divider {
  width: 2rpx;
  height: 48rpx;
  background: #F0EBE3;
}

.hero-tags {
  margin-bottom: 12rpx;
}

.update-time {
  font-size: 22rpx;
  color: #9E9A94;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #2D2A26;
}

.section-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.ingredient-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ingredient-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #FFF8F0;
  border-radius: 16rpx;
}

.ingredient-name {
  font-size: 28rpx;
  color: #2D2A26;
}

.ingredient-amount {
  font-size: 26rpx;
  color: #E85D04;
  font-weight: 500;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E85D04 0%, #F48C06 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  margin-top: 4rpx;
}

.step-text {
  flex: 1;
  font-size: 28rpx;
  color: #4A4540;
  line-height: 1.7;
}

.note-text {
  font-size: 28rpx;
  color: #6B6560;
  line-height: 1.7;
  background: #FFF8F0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  display: block;
}

.action-bar {
  display: flex;
  gap: 24rpx;
  padding: 32rpx 0 48rpx;
}

.action-btn {
  flex: 1;
}

.btn-delete {
  background: #fff;
  color: #D32F2F;
  border: 2rpx solid #D32F2F;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 18rpx 40rpx;
}

.btn-delete::after {
  border: none;
}
